<Window x:Class="ShadowClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SHADOW CLIENT — REQUIEM" Height="790" Width="1250"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#101419" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="22,25,18,24">
          <TextBlock Text="SHADOW" FontSize="25" FontWeight="Black" />
          <TextBlock Text="CLIENT  /  REQUIEM" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="1,1,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,20">
          <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="11">
            <StackPanel>
              <TextBlock Text="ACCOUNT" FontSize="10" Foreground="{StaticResource TextMuted}" FontWeight="Bold" />
              <TextBlock x:Name="SidebarAccountText" Text="Not signed in" Margin="0,5,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="AccountModeText" Text="Choose Microsoft or offline profile" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="v0.1.0  •  WINDOWS x64" FontSize="9" Foreground="#687381" Margin="3,14,0,0" />
        </StackPanel>
        <StackPanel Margin="12,0,12,0">
          <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,10" />
          <Button x:Name="NavHome" Content="⌂    Home" Tag="Home" HorizontalContentAlignment="Left" Background="#27313B" Foreground="White" Click="Navigate_Click" />
          <Button x:Name="NavVersions" Content="▤    Versions &amp; Profiles" Tag="Versions" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CAD2DA" Click="Navigate_Click" />
          <Button x:Name="NavMods" Content="◇    Mod Browser" Tag="Mods" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CAD2DA" Click="Navigate_Click" />
          <Button x:Name="NavSkins" Content="◉    Skins" Tag="Skins" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CAD2DA" Click="Navigate_Click" />
          <Button x:Name="NavSettings" Content="⚙    Settings" Tag="Settings" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CAD2DA" Click="Navigate_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,22,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="48" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="22" FontWeight="Bold" />
          <TextBlock x:Name="PageSubtitle" Text="Your game. Your setup. No clutter." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="AccountStatusText" Text="ACCOUNT NOT CONNECTED" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox x:Name="OfflineUsernameInput" Width="126" Height="36" VerticalContentAlignment="Center"
                   ToolTip="Offline username (3–16 letters, numbers or underscores). Works only on offline-mode servers." />
          <Button x:Name="UseOfflineButton" Content="Use offline" Click="UseOffline_Click"
                  Background="#29323D" Foreground="White" ToolTip="Use this username on offline-mode servers only." />
          <Button x:Name="LoginButton" Content="Microsoft login" Click="Login_Click" />
          <Button x:Name="LogoutButton" Content="Sign out" Click="Logout_Click" Visibility="Collapsed" Background="#252D36" Foreground="White" />
        </StackPanel>
      </Grid>

      <!-- HOME -->
      <Grid x:Name="HomePage" Grid.Row="1" Visibility="Visible">
        <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="16" Background="#171D24" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="28">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" MaxWidth="620">
              <TextBlock Text="PLAY BEYOND LIMITS" Foreground="#B7C1CB" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="SHADOW CLIENT" FontSize="36" FontWeight="Black" Margin="0,8,0,0" />
              <TextBlock Text="A focused Minecraft launcher with real installations, named profiles, compatible mods and practical controls." TextWrapping="Wrap" Foreground="#AAB4BE" FontSize="13" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,21,0,0">
                <Button x:Name="PlayButton" Content="▶   PLAY NOW" FontSize="14" Padding="24,13" Click="Play_Click" />
                <Button Content="Manage profiles" Background="#29323D" Foreground="White" Click="GoVersions_Click" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#0F1318" CornerRadius="12" BorderBrush="#343E49" BorderThickness="1" Margin="12,0,0,0" Padding="18">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ACTIVE PROFILE" FontSize="10" Foreground="{StaticResource TextMuted}" FontWeight="Bold" />
                <TextBlock x:Name="HomeProfileName" Text="Default" FontWeight="Bold" FontSize="21" Margin="0,9,0,0" />
                <TextBlock x:Name="HomeVersionName" Text="Minecraft 1.21.1" Foreground="#AAB4BE" FontSize="12" Margin="0,3,0,0" />
                <Separator Background="{StaticResource Line}" Margin="0,15,0,13" />
                <TextBlock Text="MEMORY ALLOCATION" FontSize="9" Foreground="{StaticResource TextMuted}" />
                <TextBlock x:Name="HomeRamText" Text="1536 MB" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="19" Margin="0,0,9,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="QUICK LAUNCH" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Choose a named profile to run." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,11" />
              <ComboBox x:Name="HomeProfileCombo" SelectionChanged="HomeProfileCombo_SelectionChanged" />
              <TextBlock Text="Only versions installed in this game directory appear after refresh. A selected version is downloaded automatically the first time you launch it." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="19" Margin="9,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="PERFORMANCE PRESET" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Lightweight defaults for modest PCs." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,12" />
              <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" />
              <TextBlock x:Name="HomeRamNote" Text="1536 MB • balanced" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,12" />
              <TextBlock Text="No bundled shader effects or heavy visual extras are forced on your game." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" />
              <Button Content="Open performance settings" Background="#29323D" Foreground="White" HorizontalAlignment="Left" Margin="0,17,0,0" Click="GoSettings_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- VERSIONS -->
      <Grid x:Name="VersionsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,15">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="INSTALL A GAME VERSION" FontWeight="Bold" FontSize="12" />
              <TextBlock Text="Choose an official Minecraft version, then install it or add a mod-loader profile." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,10" />
              <WrapPanel VerticalAlignment="Center">
                <StackPanel Width="210" Margin="0,0,12,0"><TextBlock Text="Minecraft version" FontSize="10" Foreground="{StaticResource TextMuted}"/><ComboBox x:Name="VersionCombo" /></StackPanel>
                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Loader" FontSize="10" Foreground="{StaticResource TextMuted}"/><ComboBox x:Name="LoaderCombo"><ComboBoxItem Content="Vanilla" IsSelected="True"/><ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Quilt"/></ComboBox></StackPanel>
                <StackPanel Width="220"><TextBlock Text="Profile name" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBox x:Name="ProfileNameInput" Text="My Minecraft" /></StackPanel>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
              <Button Content="Refresh versions" Background="#29323D" Foreground="White" Click="RefreshVersions_Click" />
              <Button x:Name="InstallVersionButton" Content="Install &amp; create profile" Click="InstallProfile_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="YOUR PROFILES" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Friendly names linked to real game versions." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,0" />
              </StackPanel>
              <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" />
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="PROFILE ACTIONS" FontSize="11" FontWeight="Bold" />
              <TextBlock x:Name="SelectedProfileText" Text="Select a profile" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,14" />
              <Button Content="Launch selected profile" HorizontalAlignment="Left" Click="LaunchSelectedProfile_Click" />
              <Button Content="Rename selected profile" Background="#29323D" Foreground="White" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RenameProfile_Click" />
              <Button Content="Delete profile entry" Background="#29323D" Foreground="White" HorizontalAlignment="Left" Margin="0,8,0,0" Click="DeleteProfile_Click" />
              <Separator Background="{StaticResource Line}" Margin="0,18,0,15" />
              <TextBlock Text="LOADER SUPPORT" FontWeight="Bold" FontSize="10" />
              <TextBlock Text="Built-in installer: Fabric and Quilt. Existing Forge, NeoForge or other custom version folders can be selected and launched if already installed." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- MODS -->
      <Grid x:Name="ModsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="MODRINTH DISCOVERY" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Search compatible mods, resource packs and shader packs. Downloads are filtered by game version and loader." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,10" />
            <WrapPanel>
              <TextBox x:Name="ModSearchInput" Width="320" Height="36" VerticalContentAlignment="Center" Margin="0,0,9,0" />
              <ComboBox x:Name="ModTypeCombo" Width="145" SelectedIndex="0" SelectionChanged="ModTypeCombo_SelectionChanged"><ComboBoxItem Content="Mods"/><ComboBoxItem Content="Resource packs"/><ComboBoxItem Content="Shader packs"/></ComboBox>
              <ComboBox x:Name="ModVersionCombo" Width="145" />
              <ComboBox x:Name="ModLoaderCombo" Width="130" SelectedIndex="0"><ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Quilt"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Minecraft"/></ComboBox>
              <Button Content="Search" Click="SearchMods_Click" />
              <Button Content="Install low-end Fabric pack" Background="#29323D" Foreground="White" Click="InstallPerformancePack_Click" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="SEARCH RESULTS" FontSize="10" FontWeight="Bold" Margin="3,0,0,10" />
              <ListBox x:Name="ModResultsList" />
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="INSTALLED FILES" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="LocalFilesPathText" Text=".minecraft/mods" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,9" />
              </StackPanel>
              <ListBox x:Name="LocalFilesList" />
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="Install selected" Click="InstallSelectedMod_Click" />
                <Button Content="Add file" Background="#29323D" Foreground="White" Click="AddLocalFile_Click" />
                <Button Content="Enable / disable" Background="#29323D" Foreground="White" Click="ToggleLocalFile_Click" />
                <Button Content="Remove" Background="#29323D" Foreground="White" Click="RemoveLocalFile_Click" />
                <Button Content="Open folder" Background="#29323D" Foreground="White" Click="OpenFilesFolder_Click" />
              </WrapPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- SKINS -->
      <Grid x:Name="SkinsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="PLAYER IDENTITY" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="SkinAccountName" Text="Sign in with Microsoft to manage your skin" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" />
            <TextBlock x:Name="SkinOfflineNote" Text="Offline profiles do not have an authenticated Minecraft skin. Sign in with Microsoft to view or upload your official skin." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed" />
            <Border Background="#0F1318" CornerRadius="10" Padding="16" Margin="0,18,0,18">
              <StackPanel>
                <TextBlock Text="CURRENT SKIN" FontSize="10" Foreground="{StaticResource TextMuted}" />
                <Image x:Name="CurrentSkinImage" Width="190" Height="230" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock x:Name="SkinVariantText" Text="Not loaded" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Button Content="Refresh current skin" HorizontalAlignment="Left" Click="RefreshSkin_Click" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="UPLOAD A SKIN" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Upload a PNG to the signed-in Minecraft Java profile. Your Microsoft account must own Minecraft Java Edition." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,15" />
            <TextBlock Text="Skin model" FontSize="10" Foreground="{StaticResource TextMuted}" />
            <ComboBox x:Name="SkinVariantCombo" SelectedIndex="0"><ComboBoxItem Content="Classic"/><ComboBoxItem Content="Slim"/></ComboBox>
            <Button Content="Choose PNG &amp; upload" HorizontalAlignment="Left" Margin="0,8,0,0" Click="UploadSkin_Click" />
            <TextBlock Text="Supported: PNG skin image. Uploading replaces the active skin on your official Minecraft profile." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="10" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- SETTINGS -->
      <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="GAME LOCATION" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Game files are kept separate from the launcher executable." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,8" />
            <TextBox x:Name="GameDirectoryInput" />
            <Button Content="Browse folder" HorizontalAlignment="Left" Background="#29323D" Foreground="White" Click="BrowseGameDirectory_Click" />
            <Separator Background="{StaticResource Line}" Margin="0,19,0,16" />
            <TextBlock Text="JAVA RUNTIME" FontWeight="Bold" FontSize="11" />
            <TextBlock Text="Leave blank to let the launcher locate Java. Minecraft 1.20.5 and newer requires Java 21." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBox x:Name="JavaPathInput" />
            <Button Content="Choose javaw.exe" HorizontalAlignment="Left" Background="#29323D" Foreground="White" Click="BrowseJava_Click" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="PERFORMANCE" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Choose a conservative memory cap. More RAM is not always faster." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,8" />
            <TextBlock Text="Maximum memory" FontSize="10" Foreground="{StaticResource TextMuted}" />
            <ComboBox x:Name="RamCombo" SelectedIndex="1"><ComboBoxItem Content="1024 MB"/><ComboBoxItem Content="1536 MB"/><ComboBoxItem Content="2048 MB"/></ComboBox>
            <TextBlock Text="Display width" FontSize="10" Foreground="{StaticResource TextMuted}" />
            <TextBox x:Name="WidthInput" Text="1280" />
            <TextBlock Text="Display height" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" />
            <TextBox x:Name="HeightInput" Text="720" />
            <Button Content="Save settings" HorizontalAlignment="Left" Margin="0,17,0,0" Click="SaveSettings_Click" />
            <TextBlock Text="Low-memory tip: start with 1536 MB on a 4 GB PC and close browsers before playing." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#11161C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,13,0,0">
        <Grid>
          <TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <ProgressBar x:Name="BusyProgress" Width="150" Height="5" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
